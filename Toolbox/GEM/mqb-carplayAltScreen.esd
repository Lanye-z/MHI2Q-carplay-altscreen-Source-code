###########################################################################################
# MMI-Cockpit-Carplay - Standalone CarPlay Second Screen / BaseVideo3
###########################################################################################
screen "MMI-Cockpit-Carplay" Customization

keyValue
    value   String sys 0x00000000 0
    label   "Standalone flow: INSTALL (type111 + Java80) -> reboot -> START -> reboot; no MMI Mirror sidecar required"
    poll    0

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/install_mmi_cockpit_carplay_rx.sh"
   label   "INSTALL"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/start_mmi_cockpit_carplay_rx_test.sh"
   label   "START"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/status_mmi_cockpit_carplay_test.sh"
   label   "STATUS"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/finish_mmi_cockpit_carplay_test.sh"
   label   "STORE LOGS + RESTORE"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/stop_mmi_cockpit_carplay_test.sh"
   label   "RESTORE ORIGINAL"

script
   value   sys 1 0x0100 "/eso/hmi/engdefs/scripts/mqb/force_start_mmi_cockpit_carplay_rx_test.sh"
   label   "START (alias)"
